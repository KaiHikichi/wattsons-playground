/assets/*
  cache-control: public, max-age=31536000, s-maxage=31536000, immutable

/livecodes/*
  cache-control: public, max-age=31536000, s-maxage=31536000, immutable

/livecodes/:file.map
  ! cache-control
  cache-control: public, max-age=14400, must-revalidate

/livecodes/assets/*
  ! cache-control
  cache-control: public, max-age=14400, must-revalidate

# Cloudflare Web Analytics injects a module beacon into HTML responses. In the
# /app iframe shell that makes Firefox ignore the app's import map (breaks CodeMirror).
/app
  ! cache-control
  cache-control: public, max-age=0, must-revalidate, no-transform
